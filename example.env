# Required — src/proxy.ts refreshes the auth session on every navigation and
# @supabase/ssr throws without these, even though no shipped tool needs an account.
NEXT_PUBLIC_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>

# Optional — canonical URLs, Open Graph, and JSON-LD. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Short links — the URL Shortener and the QR tool's dynamic codes, which share
# one short_links table and are the only features that read the database. Blank,
# and the shortener says it has nowhere to store a link while the QR tool's
# "make this code editable" checkbox renders disabled; static QR codes and every
# other tool are unaffected. DIRECT_URL is the non-pooled connection and is only
# needed for db:migrate, db:push, and Prisma Studio — the app never reads it.
DATABASE_URL=
DIRECT_URL=

# Optional — GA4 measurement id, `G-XXXXXXXXXX`. Even when set, gtag.js only
# loads after the visitor accepts the consent banner AND the build is
# production, so a local clone never reports into the live property.
NEXT_PUBLIC_MEASUREMENT_ID=

# AI Text Detector — Cloudflare Worker fronting @cf/meta/llama-3.1-8b-instruct-fast.
# Blank, and only that tool degrades: it renders with its controls disabled and
# says it is not configured. TEXT_DETECTOR_API overrides the NEXT_PUBLIC_ name
# server-side; the browser never calls the worker directly.
TEXT_DETECTOR_API_KEY=<SUBSTITUTE_TEXT_DETECTOR_API_KEY>
NEXT_PUBLIC_TEXT_DETECTOR_API=<SUBSTITUTE_TEXT_DETECTOR_API>

# Cloudflare Turnstile, shared by every tool that calls a model, by both
# short-link creators (the URL Shortener and dynamic QR codes), and by the DNS &
# Domain Inspector. Without the site key each one renders disabled rather than
# unprotected; without the secret every request is refused, because the challenge
# is what keeps the model budget from being drained by a script, what keeps a
# public short-link creator from becoming a phishing service, and what keeps a
# public domain lookup from becoming a free scanner running from this server's
# address. The Domain Inspector reads no other variable: DNS over HTTPS, RDAP,
# Team Cymru's ASN zones and the page probe need nothing but an outbound
# connection.
NEXT_PUBLIC_TURNSTILE_KEY=
TURNSTILE_SECRET=

# AI Image Detector — Cloudflare Worker fronting @cf/meta/llama-4-scout-17b-16e-instruct.
# The endpoint is the worker's /detect URL; a bare origin gets /detect appended.
# Blank, and only that tool degrades, exactly like the text detector.
# FAKE_IMAGE_DETECTOR_API overrides the NEXT_PUBLIC_ name server-side.
FAKE_IMAGE_DETECTOR_API_KEY=
NEXT_PUBLIC_FAKE_IMAGE_DETECTOR_API=

# Watermark Remover — Cloudflare Worker fronting
# @cf/runwayml/stable-diffusion-v1-5-inpainting. The worker answers POST on
# whatever route it is mounted at, so no path is appended: give the full URL.
# Blank, and only that tool degrades, exactly like the detectors.
# WATERMARK_REMOVER_API overrides the NEXT_PUBLIC_ name server-side; the browser
# never calls the worker directly, which is also why the worker's five-uploads-a
# -minute limit is counted against this server's address rather than a visitor's.
WATERMARK_REMOVER_API_KEY=
NEXT_PUBLIC_WATERMARK_REMOVER_API=
