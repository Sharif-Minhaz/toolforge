// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts as of Prisma 7.
  // https://pris.ly/d/config-datasource
}

/// A re-pointable short link: the address that was printed or shared, and where
/// it currently goes. Shared by the QR tool's dynamic codes and by the URL
/// Shortener — they differ only in what gets handed to the reader, so one table
/// and one keyspace serve both.
///
/// The slug is the primary key because it is the only thing a visit carries — a
/// surrogate id would be a second identity nothing ever uses. It also means a
/// chosen alias and a drawn slug can never quietly collide.
///
/// `editTokenHash` is a SHA-256 digest, never the token itself. Whoever holds
/// the token can re-point a printed code, so a database dump must not hand that
/// ability over. `passwordHash` is a salted PBKDF2 digest for the same reason.
model ShortLink {
  slug          String    @id
  target        String
  editTokenHash String    @unique @map("edit_token_hash")
  /// Null when anyone following the link goes straight through.
  passwordHash  String?   @map("password_hash")
  /// Null means "live already"; null expiry means "never stops".
  startsAt      DateTime? @map("starts_at")
  expiresAt     DateTime? @map("expires_at")
  scans         Int       @default(0)
  lastScanAt    DateTime? @map("last_scan_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("short_links")
}

/// One row per visitor per rolling window, counting port scans.
///
/// A port scan runs from this server, so the host being scanned sees this
/// site's address in its logs rather than the visitor's. Without a limit that
/// survives a cold start, the tool is a free anonymous scanning service with
/// this site's reputation attached — which is why the counter lives in Postgres
/// rather than in a process that Vercel is free to recycle between requests.
///
/// The visitor is identified by a salted SHA-256 of their address, never the
/// address itself. The whole point is to spend nothing on knowing who they are:
/// a dump of this table says how often somebody scanned, and nothing about who.
/// That also means the salt is a secret — rotate it and every window resets,
/// which is the correct failure.
model PortScanQuota {
  /// SHA-256 of `PORT_SCAN_IP_SALT` + the caller's address.
  visitorHash String   @id @map("visitor_hash")
  count       Int      @default(0)
  /// Start of the window this count belongs to; a request past the window
  /// length resets both fields rather than adding a row.
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Sweeping expired rows is a scan over this, not over the table.
  @@index([windowStart])
  @@map("port_scan_quota")
}

// ─────────────────────────────────────────────────────────────────────────────
// Visual Mock Server Studio
//
// See docs/mock-server-studio.md for the design these models implement. The
// whole data model lands in one migration because the relations only make sense
// together; the milestones after M0 fill the tables rather than add them.
// ─────────────────────────────────────────────────────────────────────────────

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
  /// RFC 10008. Safe, idempotent, cacheable, and carries a request body.
  /// Served from `src/proxy.ts` rather than the route handler, because Next.js
  /// route files can only export the seven above.
  QUERY

  @@map("http_method")
}

/// Which level of the tree an environment variable is attached to.
enum VariableScope {
  WORKSPACE
  SERVER
  COLLECTION

  @@map("variable_scope")
}

/// A visitor's whole world: their servers, endpoints, variables and logs.
///
/// There is no account. Ownership is proved by one of two credentials, and
/// **both are stored only as SHA-256 digests** — a database dump must not hand
/// over the ability to edit somebody's mock APIs.
///
/// - A row in `workspace_secrets` matches a secret held in an HttpOnly cookie.
///   That is the session credential, one per browser, and it proves ownership
///   on every studio action.
/// - `recoveryHash` matches the printable key shown once at creation. That is
///   the bearer credential, and the only way to reach a workspace from a
///   browser that does not already hold a secret.
///
/// Neither is salted or stretched, and deliberately so: both are uniform random
/// values of 80 bits or more, which is not something a dictionary reaches. The
/// stretching in `short_links` exists because a link password is human-chosen.
model Workspace {
  id           String @id @default(uuid(7)) @db.Uuid
  name         String
  recoveryHash String @unique @map("recovery_hash")

  /// Bumped whenever the recovery key is rotated, so a key someone wrote down
  /// two rotations ago cannot be replayed even if its digest were recovered.
  recoveryEpoch Int @default(1) @map("recovery_epoch")

  /// Studio preferences that no query ever filters on.
  settings Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Touched when the studio loads. The only thing a dormancy sweep needs, and
  /// far cheaper than deriving it from the newest row in `request_logs`.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  secrets   WorkspaceSecret[]
  servers   MockServer[]
  variables EnvironmentVariable[]
  logs      RequestLog[]

  @@index([lastSeenAt])
  @@map("workspaces")
}

/// One browser's claim on one workspace.
///
/// A row per device rather than a column on `workspaces`, because importing a
/// recovery key into a second browser has to *add* a claim. With a single
/// column the import would have to overwrite it, silently evicting the browser
/// that created the workspace — and a recovery key whose use logs you out
/// elsewhere is not a recovery key.
///
/// The digest is the primary key: it is the only thing a request carries, and a
/// surrogate id would be a second identity nothing ever looks up by.
model WorkspaceSecret {
  /// SHA-256 of the secret in that browser's cookie. Never the secret.
  secretHash  String @id @map("secret_hash")
  workspaceId String @map("workspace_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  /// Lets the settings page list "this device and two others", and lets a
  /// future sweep drop claims nobody has used in a year.
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_secrets")
}

/// One deployable mock API.
///
/// `key` is what appears in the public address, so it is globally unique rather
/// than unique per workspace — two workspaces cannot both own `payments`.
model MockServer {
  id          String  @id @default(uuid(7)) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  key         String  @unique
  name        String
  description String?

  /// CORS rules, default response headers, the content-type policy and base
  /// latency. JSONB because nothing queries inside it.
  config Json @default("{}")

  /// A paused server answers 503 rather than 404, so a caller can tell the
  /// difference between "switched off" and "never existed".
  isPaused Boolean @default(false) @map("is_paused")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collections Collection[]
  endpoints   Endpoint[]

  @@index([workspaceId])
  @@map("mock_servers")
}

/// A folder inside a server.
///
/// Self-referencing rather than a fixed three-level hierarchy, because an
/// OpenAPI import arrives with whatever tag depth its author chose — and this
/// is the one thing here that could not be retrofitted without a data
/// migration.
model Collection {
  id       String  @id @default(uuid(7)) @db.Uuid
  serverId String  @map("server_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String

  /// Materialised ancestor path (`/auth/admin`), so breadcrumbs and ordering
  /// cost one indexed read rather than a recursive query.
  path String

  sortOrder Int @default(0) @map("sort_order")

  /// Collection-level defaults — auth, headers, base path — inherited by every
  /// endpoint underneath unless that endpoint overrides them.
  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  server    MockServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  parent    Collection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Collection[] @relation("CollectionTree")
  endpoints Endpoint[]

  @@index([serverId, path])
  @@index([parentId])
  @@map("collections")
}

/// One route, and the graph that answers it.
///
/// The graph lives on this row rather than in a joined table because this is
/// the hot path: a public request reads one row and nothing else. Version
/// history, when it arrives, is an append-only sibling table — additive,
/// because `graph` is already a self-contained document carrying its own
/// `schemaVersion`.
model Endpoint {
  id           String  @id @default(uuid(7)) @db.Uuid
  serverId     String  @map("server_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid

  method HttpMethod

  /// Normalised at write time: leading slash, no trailing slash, `:name` for a
  /// parameter, a single trailing `*` for a wildcard tail.
  pathPattern String @map("path_pattern")

  /// Both precomputed at write time so a public request selects candidates with
  /// one indexed query and ranks them with arithmetic rather than parsing.
  /// `specificity` is a base-3 number read left to right, one digit per
  /// segment: 2 static, 1 parameter, 0 wildcard. Higher wins.
  segmentCount Int     @map("segment_count")
  specificity  Int
  hasWildcard  Boolean @default(false) @map("has_wildcard")

  name        String
  description String?
  isEnabled   Boolean @default(true) @map("is_enabled")

  /// A `GraphDocument`. Carries its own `schemaVersion` so an endpoint saved
  /// against an older node set keeps executing after the format moves on.
  graph Json

  /// Optimistic-concurrency token. Every save asserts the version it read, so
  /// two studio tabs cannot silently overwrite each other.
  version Int @default(1)

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  server     MockServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([serverId, method, pathPattern])
  /// Candidate selection for a public request: one server, enabled rows, and
  /// the segment count the incoming path has.
  @@index([serverId, isEnabled, segmentCount])
  @@index([collectionId])
  @@map("endpoints")
}

/// A value a graph can read, at one of three levels of the tree.
///
/// Scope is one `(type, id)` pair rather than three nullable foreign keys,
/// because Postgres treats NULLs as distinct: a unique constraint spanning
/// nullable scope columns would silently permit the duplicates it looks like it
/// prevents.
model EnvironmentVariable {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  scopeType   VariableScope @map("scope_type")
  scopeId     String        @map("scope_id") @db.Uuid

  /// "default", "staging", … — one row per environment per key.
  environment String @default("default")

  key   String
  value String

  /// Masked in the UI, and never written into a log line or a trace entry.
  isSecret Boolean @default(false) @map("is_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId, environment, key])
  @@index([workspaceId])
  @@map("environment_variables")
}

/// One row per public request.
///
/// Capped per workspace and truncated per field. People post real bearer tokens
/// at their mock servers, so `authorization`, `cookie` and friends are redacted
/// before the row is written rather than filtered when it is read.
model RequestLog {
  id          String  @id @default(uuid(7)) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  serverId    String  @map("server_id") @db.Uuid
  /// Null when nothing matched — which is exactly the row worth reading.
  endpointId  String? @map("endpoint_id") @db.Uuid

  method     String
  path       String
  status     Int
  durationMs Int    @map("duration_ms")

  /// `{ headers, query, bodyPreview, bodyTruncated }`, already redacted.
  request Json
  /// `{ headers, bodyPreview, bodyTruncated }`.
  response Json
  /// Which nodes ran, in order, with per-node milliseconds. Powers the trace
  /// panel; null for a request that matched nothing.
  trace Json?

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([serverId, createdAt(sort: Desc)])
  @@map("request_logs")
}

/// One hosted `json-server`: a whole `db.json` and the address it answers on.
///
/// Flat on purpose. The Mock Server Studio puts a `Workspace` above its servers
/// because a workspace owns variables, logs and several servers that share them;
/// a JSON server owns nothing but its own document, so a layer above it would be
/// a folder containing one thing.
///
/// Ownership works exactly as it does there, and for the same reasons: a secret
/// in an HttpOnly cookie is the session credential, a printable recovery key is
/// the bearer credential that revives the server in another browser, and **both
/// are stored only as SHA-256 digests** — a database dump must not hand over the
/// ability to rewrite somebody's data.
///
/// `key` is what appears in the public address, so it is unique across this
/// table rather than per owner. It is a separate namespace from `mock_servers`:
/// the two answer under different path prefixes, so `/j/payments` and
/// `/m/payments` are different servers and neither shadows the other.
model JsonServer {
  id            String @id @default(uuid(7)) @db.Uuid
  key           String @unique
  name          String
  recoveryHash  String @unique @map("recovery_hash")
  /// Bumped whenever the recovery key is rotated, so a key written down two
  /// rotations ago cannot be replayed even if its digest were recovered.
  recoveryEpoch Int    @default(1) @map("recovery_epoch")

  /// The live document — every collection and singular resource. JSONB because
  /// nothing queries inside it: `json-server` itself holds the whole database in
  /// memory and rewrites the file, and reproducing that is the point. Every
  /// write is a read-modify-write under a row lock, which is what makes two
  /// concurrent POSTs impossible to interleave.
  db     Json
  /// What the document was created with, so "reset" is a real button rather
  /// than an instruction to paste the file again.
  seedDb Json @map("seed_db")

  /// UTF-8 bytes of `db`, maintained on every write.
  ///
  /// Stored rather than derived because the write gate reads it on every
  /// request: re-serialising a megabyte of JSONB to answer "is this server
  /// full" would cost more than the write it is guarding.
  sizeBytes Int @default(0) @map("size_bytes")

  /// A paused server answers 503 rather than 404, so a caller can tell the
  /// difference between "switched off" and "never existed".
  isPaused Boolean @default(false) @map("is_paused")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// Touched when the studio loads it. The only thing a dormancy sweep needs.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  secrets JsonServerSecret[]
  logs    JsonServerLog[]

  @@index([lastSeenAt])
  @@map("json_servers")
}

/// One browser's claim on one JSON server.
///
/// A row per device rather than a column, for the reason `workspace_secrets`
/// gives: importing a recovery key into a second browser has to *add* a claim,
/// and a recovery key whose use logs you out elsewhere is not a recovery key.
model JsonServerSecret {
  /// SHA-256 of the secret in that browser's cookie. Never the secret.
  secretHash String @id @map("secret_hash")
  serverId   String @map("server_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  server JsonServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("json_server_secrets")
}

/// The last few calls a JSON server answered.
///
/// Deliberately narrower than `request_logs`: a method, a path, a status and a
/// duration, and **no headers and no bodies at all**. The mock studio logs those
/// because an author is debugging what a client sent; here the request bodies
/// *are* the visitor's data, already stored once in `db`, and keeping a second
/// redacted copy of them would be this service quietly retaining more than it
/// says. What is left still answers the question people actually have, which is
/// why a client got a 404.
model JsonServerLog {
  id       String @id @default(uuid(7)) @db.Uuid
  serverId String @map("server_id") @db.Uuid

  method     String
  /// Path and query as received, so `?_page=2` is visible. Truncated on write.
  path       String
  status     Int
  durationMs Int    @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  server JsonServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt(sort: Desc)])
  @@map("json_server_logs")
}

/// Every fixed-window allowance on this site that counts a caller without
/// naming one, in one table.
///
/// The same shape and the same reasoning as `port_scan_quota`. A cookie's
/// "three workspaces" or "five JSON servers" is a UI affordance — a visitor who
/// clears it gets more — so the limit that actually holds lives here, keyed on a
/// salted digest and never on the address itself.
///
/// Shared between the Mock Server Studio and the JSON Server Studio, which is
/// safe because every key is a digest of a **namespaced** string (`mock:serve:…`,
/// `json:serve:…`, `mock:outbound:…`). Two limits therefore cannot land on one
/// row, and adding a third costs a namespace rather than a table. Named
/// `service_quota` rather than `mock_quota` since the second caller arrived.
model ServiceQuota {
  /// SHA-256 of a salt, a namespace and whatever the limit is keyed on.
  visitorHash String   @id @map("visitor_hash")
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([windowStart])
  @@map("service_quota")
}

/// One hosted GraphQL server: a stored `db.json`, a public key, and a schema
/// derived from the document on every request.
///
/// Shaped like `json_servers` on purpose — the same document, the same
/// ownership model, the same size accounting — because the two studios serve
/// one kind of thing two ways and a visitor should be able to point both at the
/// same fixture. What differs is entirely in how a request is answered, which is
/// code rather than columns.
///
/// A separate table rather than a `protocol` column on `json_servers`. Two
/// reasons, and the second is the one that settles it: the log rows are
/// genuinely different shapes — a method and a path there, an operation name and
/// a node cost here — and a shared table would have to hold both and mean
/// neither. And `key` is unique *within* a table, so separate tables are what
/// let `/j/payments` and `/g/payments` be two different servers, exactly as
/// `/m/payments` already is.
model GraphqlServer {
  id            String @id @default(uuid(7)) @db.Uuid
  key           String @unique
  name          String
  recoveryHash  String @unique @map("recovery_hash")
  /// Bumped whenever the recovery key is rotated, so a key written down two
  /// rotations ago cannot be replayed even if its digest were recovered.
  recoveryEpoch Int    @default(1) @map("recovery_epoch")

  /// The live document. JSONB because nothing queries inside it: the schema is
  /// derived in memory on every request and every mutation is a
  /// read-modify-write under a row lock, which is what makes two concurrent
  /// mutations impossible to interleave.
  db     Json
  /// What the document was created with, so "reset" is a real button rather
  /// than an instruction to paste the file again.
  seedDb Json @map("seed_db")

  /// UTF-8 bytes of `db`, maintained on every write.
  ///
  /// Stored rather than derived because the write gate reads it on every
  /// mutation: re-serialising a megabyte of JSONB to answer "is this server
  /// full" would cost more than the write it is guarding.
  sizeBytes Int @default(0) @map("size_bytes")

  /// A paused server answers 503 rather than 404, so a caller can tell the
  /// difference between "switched off" and "never existed".
  isPaused Boolean @default(false) @map("is_paused")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  /// Touched when the studio loads it. The only thing a dormancy sweep needs.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  secrets GraphqlServerSecret[]
  logs    GraphqlServerLog[]

  @@index([lastSeenAt])
  @@map("graphql_servers")
}

/// One browser's claim on one GraphQL server.
///
/// A row per device rather than a column, for the reason `json_server_secrets`
/// gives: importing a recovery key into a second browser has to *add* a claim,
/// and a recovery key whose use logs you out elsewhere is not a recovery key.
model GraphqlServerSecret {
  /// SHA-256 of the secret in that browser's cookie. Never the secret.
  secretHash String @id @map("secret_hash")
  serverId   String @map("server_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  server GraphqlServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("graphql_server_secrets")
}

/// The last few operations a GraphQL server answered.
///
/// **The operation name, never the query.** A GraphQL request body is the whole
/// document, and a document is largely the visitor's own field names against
/// their own data — logging it would mean this service keeps a second copy of
/// what it already stores once in `db`, which is the same line
/// `json_server_logs` draws and for the same reason. The name, the type, the
/// status and the cost still answer the question people actually have, which is
/// why a query was refused.
///
/// `cost` is here and has no equivalent in the REST log because it is the one
/// number that explains a 400 nobody expected: a query rejected as too costly
/// looks identical to one rejected as invalid unless the estimate is visible.
model GraphqlServerLog {
  id       String @id @default(uuid(7)) @db.Uuid
  serverId String @map("server_id") @db.Uuid

  /// Null for an anonymous operation, which is what most hand-written queries are.
  operationName String? @map("operation_name")
  /// `query` or `mutation`, or `unknown` when the document never parsed.
  operationType String  @map("operation_type")
  status        Int
  durationMs    Int     @map("duration_ms")
  /// The estimated node count the guard computed. Zero when it never ran.
  cost          Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  server GraphqlServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt(sort: Desc)])
  @@map("graphql_server_logs")
}
