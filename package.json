{
    "name": "toolforge",
    "version": "0.1.0",
    "private": true,
    "description": "A privacy-first toolbox of developer utilities. Everything runs in the browser.",
    "license": "MIT",
    "author": "Sharif Minhaz",
    "homepage": "https://github.com/Sharif-Minhaz/toolforge#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sharif-Minhaz/toolforge.git"
    },
    "bugs": {
        "url": "https://github.com/Sharif-Minhaz/toolforge/issues"
    },
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate dev",
        "db:deploy": "bunx --bun prisma migrate deploy",
        "db:push": "bunx --bun prisma db push",
        "db:studio": "bunx --bun prisma studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@jsquash/avif": "^2.1.1",
        "@jsquash/jpeg": "^1.6.0",
        "@jsquash/oxipng": "^2.3.0",
        "@jsquash/resize": "^2.1.1",
        "@jsquash/webp": "^1.5.0",
        "@next/third-parties": "^16.2.12",
        "@prisma/adapter-pg": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "@supabase/ssr": "^0.12.3",
        "@supabase/supabase-js": "^2.110.8",
        "@tabler/icons-react": "^3.45.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "fflate": "^0.8.3",
        "hash-wasm": "^4.12.0",
        "jose": "^6.2.4",
        "jsqr": "^1.4.0",
        "katex": "^0.18.1",
        "lucide-react": "^1.27.0",
        "marked": "^18.0.7",
        "mermaid": "^11.16.0",
        "motion": "^12.42.2",
        "next": "16.2.12",
        "next-intl": "^4.13.4",
        "next-themes": "^0.4.6",
        "pg": "^8.22.0",
        "react": "19.2.4",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1",
        "shadcn": "^4.15.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/bun": "^1.3.14",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "blurhash": "^2.0.5",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-next": "16.2.12",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prisma": "^7.9.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.1",
        "typescript": "^5"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
